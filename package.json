{
  "name": "custos",
  "version": "2.2.2",
  "description": "Anti-cheat scanner for Unturned servers",
  "main": "./out/main/index.js",
  "author": "COBRA",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "debug": "electron-vite build && electron-builder --win --dir",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:win:admin": "npm run package:win && node scripts/build-with-manifest.js",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:latest-files": "node --experimental-strip-types --test scripts/test-latest-files.mjs scripts/test-latest-files-store.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^3.0.0",
    "clsx": "^2.1.1",
    "electron-store": "^8.2.0",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.0",
    "react-router-dom": "^7.16.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  }
}
